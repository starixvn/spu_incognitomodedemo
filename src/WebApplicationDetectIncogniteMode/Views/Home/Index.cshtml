@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <div class="wrapper">
        <h1>Is this a Private Browsing window?</h1>
        <p id="answer" style="font-size:3em"><noscript><b>detectIncognito requires JavaScript in order to function</b>, please enable it.</noscript><br /></p>
        <br />
        <h2>Log:</h2>
        <div id="add_to_me"></div>
    </div>
    <script src="~/lib/detectincognitomode/es5/detectIncognito.min.js"></script>
    <script>
        var exports = {};
        function getModeName(browserName) {
            switch (browserName) {
                case "Safari":
                case "Firefox":
                case "Brave":
                case "Opera":
                    return "a Private Window";
                    break;
                case "Chrome":
                case "Chromium":
                    return "an Incognito Window";
                    break;
                case "Internet Explorer":
                case "Edge":
                    return "an InPrivate Window";
                    break;
            }
            throw new Error("Could not get mode name");
        }

        // This function is called when the script is loaded
        function detect() {
            var a = document.getElementById("answer");
            // We call the detectIncognito function and handle the promise
            detectIncognito().then(function (result) {
                if (result.isPrivate) { // If the result is private, we display a message to the user
                    a.innerHTML = "<b>Yes</b>. You are using " + result.browserName + " in " + getModeName(result.browserName) + ".";
                } else { // If the result is not private, we display a message to the user
                    a.innerHTML = "<b>No</b>. You are using " + result.browserName + " in a regular browser window edited.";
                }
            }).catch(function (error) { // If there is an error, we display a message to the user & log the error to console
                a.innerHTML = "<b>There was an error.</b> Check console for further information. If the problem persists, please <a href='https://github.com/Joe12387/detectIncognito/issues'>report the issue</a> on GitHub.";
                console.error(error);
            });
        }
        detect();


        addCode('test uc browser');


        function addCode(object) {
            document.getElementById("add_to_me")
                .innerHTML +=
                `<p>` + object + `</p>`;
        }


        //Write your JavaScript code.
        console.log('---Compare memory with storage quota');
        try {
           let jsHeapSizeLimit = performance.memory.jsHeapSizeLimit;
           console.log('jsHeapSizeLimit (MB): ', Math.round(jsHeapSizeLimit / (1024 * 1024)));
           console.log('jsHeapSizeLimit * 2 (MB): ', Math.round(jsHeapSizeLimit / (1024 * 1024)) * 2);
           getLocalStorage();
        } catch (e) {
           console.log('Browser does not support');
        }

        try {
           console.log('---Check service workder is enable');
           addCode('navigator.serviceWorker: ' + typeof(navigator.serviceWorker));

        } catch (e) {
           addCode("error service worker " + e.message);
        }

        console.log('---Try to store Blob object in indexedDB');
        const databaseName = 'testIndexedDB';

        isDatabaseExists(databaseName).then(exists => {
           if (exists) {
               window.indexedDB.deleteDatabase(databaseName);
           }
           storeBlobToIndexedDB(databaseName);
        });











        function storeBlobToIndexedDB(databaseName) {
            try {
                const db = window.indexedDB.open(databaseName, 1);
                addCode('database is opened ');
                db.onupgradeneeded = function (i) {
                    const res = i.target?.result;

                    try {
                        const objectStore = res.createObjectStore('testObjectStore', {
                            autoIncrement: true
                        });
                        addCode('ObjectStore is created');

                        const studentA = {
                            name: 'Andres',
                            lastname: 'Valdivia',
                            email: 'pandres@pandres.com',
                            age: 22
                        };
                        objectStore.put(studentA);
                        console.log('JS Object is created');

                        const blobObj = new Blob();
                        console.log('Size of blob object: ', blobObj.size);
                        objectStore.put(blobObj);
                        addCode('Blob object is created');
                    } catch (ex) {
                        addCode("error add data to indexedDB " + ex.message);
                    }
                    finally {
                        res.close();
                    }
                }
            } catch (e) {
                addCode("error open indexedDB " + e.message);
            }
        }


        function getLocalStorage() {
            navigator.webkitTemporaryStorage.queryUsageAndQuota(
                function (usage, quota) {
                    //console.log('Storage used: ', usage);
                    //console.log('Storage quota: ', quota);
                    const quotaInMib = Math.round(quota / (1024 * 1024));
                    console.log('Storage quota (MB): ', quotaInMib);
                },
                function (e) {
                    reject(
                        new Error(
                            'detectIncognito somehow failed to query storage quota: ' +
                            e.message
                        )
                    );
                }
            )
        }

        async function isDatabaseExists(dbName) {
            try {
                const databases = await indexedDB.databases();
                return databases.some(db => db.name === dbName);
            } catch (e) {
                addCode("error checkdatabase exist " + e.message);
            }

        }


    </script>

</div>
